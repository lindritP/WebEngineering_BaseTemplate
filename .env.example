# Copy to .env (cp .env.example .env) and choose your own values.
# Used by Docker Compose for the db service and the api's DATABASE_URL.
POSTGRES_USER=bears
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bears

# Only for running the API on the host (npm run dev): the db port is published
# on localhost. Inside Compose the api builds its own URL with host "db".
DATABASE_URL=postgresql://bears:change-me@localhost:5432/bears
